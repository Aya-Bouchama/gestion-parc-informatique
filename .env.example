# Copier ce fichier en .env puis adapter les valeurs. Ne JAMAIS versionner .env.

# Clé secrète Flask (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Base de données : SQLite, fichier data/gestion.sqlite3 créé automatiquement.
# Rien à installer ni à configurer.

# --- OCR ---
# Sous Windows uniquement, si tesseract n'est pas dans le PATH :
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng+fra

# --- Web ---
CORS_ORIGINS=*
WEB_PORT=8000
